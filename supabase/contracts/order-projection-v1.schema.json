{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:armazem:v2:order-projection:1",
  "title": "Armazem V2 Order Projection Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "idempotencyKey",
    "fingerprint",
    "requestId",
    "actor",
    "eventId",
    "eventType",
    "eventCreatedAt",
    "order"
  ],
  "properties": {
    "contractVersion": { "const": 1 },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^idempotency:v2:[a-f0-9]{64}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "requestId": {
      "type": "string",
      "maxLength": 160
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "eventType": { "const": "order.created.v2" },
    "eventCreatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "order": { "$ref": "#/$defs/order" }
  },
  "$defs": {
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "orderNumber",
        "orderCode",
        "displayId",
        "status",
        "seller",
        "customer",
        "items",
        "qty",
        "pricing",
        "integrity",
        "source",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "schemaVersion": { "const": 2 },
        "orderNumber": {
          "type": "string",
          "pattern": "^PED[0-9]{7}[A-Z]+$"
        },
        "orderCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "displayId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "seller": { "$ref": "#/$defs/seller" },
        "customer": { "$ref": "#/$defs/customer" },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": { "$ref": "#/$defs/item" }
        },
        "qty": {
          "type": "integer",
          "minimum": 1
        },
        "pricing": { "$ref": "#/$defs/pricing" },
        "integrity": { "$ref": "#/$defs/integrity" },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "seller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "label": {
          "type": "string",
          "maxLength": 120
        }
      }
    },
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "whatsapp", "phone"],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 160
        },
        "whatsapp": {
          "type": "string",
          "pattern": "^[0-9]{0,20}$"
        },
        "phone": {
          "type": "string",
          "pattern": "^[0-9]{0,20}$"
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId",
        "driveFileId",
        "code",
        "originalName",
        "theme",
        "subtheme",
        "productKey",
        "productName",
        "variantKey",
        "sizeKey",
        "quantity",
        "unitPrice",
        "lineSubtotal",
        "details"
      ],
      "properties": {
        "itemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "driveFileId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "originalName": {
          "type": "string",
          "maxLength": 300
        },
        "theme": {
          "type": "string",
          "maxLength": 200
        },
        "subtheme": {
          "type": "string",
          "maxLength": 200
        },
        "productKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "productName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "variantKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "sizeKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "unitPrice": {
          "type": "number",
          "minimum": 0,
          "multipleOf": 0.01
        },
        "lineSubtotal": {
          "type": "number",
          "minimum": 0,
          "multipleOf": 0.01
        },
        "details": {
          "type": ["object", "array", "string", "number", "boolean", "null"]
        }
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "subtotal",
        "discountPercent",
        "discountAmount",
        "total",
        "calculationVersion"
      ],
      "properties": {
        "currency": { "const": "BRL" },
        "subtotal": {
          "type": "number",
          "minimum": 0,
          "multipleOf": 0.01
        },
        "discountPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "discountAmount": {
          "type": "number",
          "minimum": 0,
          "multipleOf": 0.01
        },
        "total": {
          "type": "number",
          "minimum": 0,
          "multipleOf": 0.01
        },
        "calculationVersion": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalogVersion",
        "configVersion",
        "productRegistryVersion",
        "requestItemCount",
        "canonicalItemCount"
      ],
      "properties": {
        "catalogVersion": {
          "type": "integer",
          "minimum": 1
        },
        "configVersion": {
          "type": "integer",
          "minimum": 1
        },
        "productRegistryVersion": {
          "type": "integer",
          "minimum": 1
        },
        "requestItemCount": {
          "type": "integer",
          "minimum": 0
        },
        "canonicalItemCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
